# ===========================================================================
# TIC Platform environment - copy to `.env` and fill in.  NEVER commit `.env`.
#   cp .env.example .env
# Generate secrets with:  openssl rand -base64 48
# ===========================================================================

# --- Public URL --------------------------------------------------------------
# The address people type in the browser. Used for links in emails.
# On the server: http://<SERVER_IP>  (or http://<SERVER_IP>:<HTTP_PORT> if not 80)
TIC_PORTAL_BASE_URL=http://localhost
HTTP_PORT=80

# --- Database ----------------------------------------------------------------
POSTGRES_DB=tic
POSTGRES_USER=tic
POSTGRES_PASSWORD=change-me-strong-db-password
# Host port for psql / local backend dev (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5432

# --- Security ----------------------------------------------------------------
# HS256 signing key for login tokens - at least 32 characters, keep it secret.
TIC_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
TIC_JWT_ACCESS_TOKEN_MINUTES=15

# --- First administrator -----------------------------------------------------
# Created on first start if it does not exist (never overwritten afterwards).
TIC_ADMIN_EMAIL=admin@agricert.co.ke
TIC_ADMIN_PASSWORD=change-me-admin-password

# Seed reference data (roles, permissions, default organization). Keep true.
TIC_SEED_ENABLED=true
# Demo accounts supervisor@/inspector@/farmer@agricert.co.ke with password Dev@12345.
# Handy for a test server - set to false for real customers.
TIC_SEED_DEMO_USERS=false

# --- Email (invitations & password resets) -----------------------------------
# Default: Mailpit test inbox (start with `docker compose --profile mail up -d`).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
TIC_MAIL_FROM=no-reply@tickenya.local

# Gmail instead (needs 2-Step Verification + a 16-character App Password):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# TIC_MAIL_FROM=your-account@gmail.com

# Invitation / reset links stay valid this many hours (168 = 7 days)
TIC_ACCOUNT_SETUP_TOKEN_HOURS=168
